// codex.miberarave.xyz: the MiCodex docs site, as static files on Cloudflare (gumi's account, 2026-11-03).
// `pnpm build` writes dist/; `npx wrangler deploy` uploads it. The custom domain makes its own DNS record, which wins
// over miberarave.xyz's wildcard (the hub on Vercel), the same way vending. and micamp. work.
{
  "name": "micodex",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "codex.miberarave.xyz", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
